package draw

// A bitmap font: fixed-width glyphs for the characters from `first`, each
// `height` rows of `width` bits (the high bit of the width the leftmost).
Font :: struct {
	width, height: int,
	first:         u8,
	glyphs:        [][7]u8,
	advance:       int, // from one character to the next
	line:          int, // from one line to the next
}

// The bundled font: 5x7 pixels, printable ASCII (others drawn as '?').
FONT_5X7 := Font{width = 5, height = 7, first = 32, glyphs = GLYPHS_5X7[:], advance = 6, line = 9}

// How text lines up in a rectangle.
Align :: enum u8 {
	Left,
	Center,
	Right,
}

// Draws text with its top left at (x, y), `scale` times as big. The x
// after it.
text :: proc(cv: ^Canvas, f: ^Font, x, y: int, s: string, c: u32, scale := 1) -> int {
	cx := x
	for ch in s {
		if ch == '\n' do continue
		draw_glyph(cv, f, cx, y, ch, c, scale)
		cx += f.advance * scale
	}
	return cx
}

// How wide text is, in pixels (without the last character's gap).
text_width :: proc(f: ^Font, s: string, scale := 1) -> int {
	n := 0
	for _ in s do n += 1
	return max(n * f.advance - (f.advance - f.width), 0) * scale
}

// Draws text in a rectangle: aligned across it, centred down it, cut to
// what fits (clipped to it).
text_in :: proc(cv: ^Canvas, f: ^Font, r: Rect, s: string, c: u32, align := Align.Left, scale := 1) {
	w := text_width(f, s, scale)
	x := r.x
	switch align {
	case .Left:
	case .Center: x = r.x + (r.w - w) / 2
	case .Right: x = r.x + r.w - w
	}
	y := r.y + (r.h - f.height * scale) / 2
	old := cv.clip
	set_clip(cv, intersect(r, old))
	text(cv, f, x, y, s, c, scale)
	cv.clip = old
}

@(private)
draw_glyph :: proc(cv: ^Canvas, f: ^Font, x, y: int, ch: rune, c: u32, scale: int) {
	i := int(ch) - int(f.first)
	if i < 0 || i >= len(f.glyphs) do i = int('?') - int(f.first)
	g := f.glyphs[i]
	for row in 0 ..< f.height do for col in 0 ..< f.width {
		if g[row] & (1 << u8(f.width - 1 - col)) == 0 do continue
		if scale == 1 {
			set(cv, x + col, y + row, c)
		} else {
			fill_rect(cv, {x + col * scale, y + row * scale, scale, scale}, c)
		}
	}
}

@(private)
